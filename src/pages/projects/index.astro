---
import { Proyects } from 'src/components/react/Proyects';
import Layout from '@layouts/Layout.astro';
import { getProjectsCollection } from 'src/utils/getProjectsCollection';

const projectEntries = await getProjectsCollection();
const projects = projectEntries.map(({ id, data }) => ({
  id,
  data: {
    title: data.title,
    summary: data.summary,
    isInConstruction: data.isInConstruction,
    tags: data.tags
  }
}));
---

<Layout title="Proyectos">
  <main id="main-content" class="wrapper">
    <div class="projects">
      <Proyects client:only="react" initialProyects={projects} />
    </div>
  </main>
</Layout>

<style>
  .projects {
    padding: 8rem 1rem 1rem 1rem;

    display: grid;
    gap: 1.5rem;
  }
  @media screen and (min-width: 1200px) {
    .projects {
      grid-template-columns: 250px 1fr;
    }
  }
</style>
